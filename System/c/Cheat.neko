# Battle speed function
	class << Graphics
		def neko_get_speed
			if SceneManager.scene_is?(Scene_Battle)
				if $game_player.opening("battle")
					return $game_player.opening("battle") 
				end
			else
				if $game_player.opening("nobattle")
					return $game_player.opening("nobattle") 
				end
			end
			return 1
		end
		def spd_frame_count
			@spd_frame_count = Graphics.frame_count if @spd_frame_count == nil
			return @spd_frame_count
		end
		def spd_frame_count=(count)
			@spd_frame_count = count
		end
		alias :neko_update_spd :update if !$setting
		def update
			if Graphics.frame_count % neko_get_speed.to_i > 0
				Graphics.frame_count += 1
			else
				Graphics.spd_frame_count += 1
				neko_update_spd
			end
		end
		alias :neko_wait_spd :wait if !$setting
		def wait(duration)
			duration /= neko_get_speed
			neko_wait_spd(duration)
		end
		alias :neko_fadein_spd :fadein if !$setting
		def fadein(duration)
			duration /= neko_get_speed
			neko_fadein_spd(duration)
		end
		alias :neko_fadeout_spd :fadeout if !$setting
		def fadeout(duration)
			duration /= neko_get_speed
			neko_fadeout_spd(duration)
		end
		alias :neko_transition_spd :transition if !$setting
		def transition(duration = 10, filename = "", vague = 40)
			duration /= neko_get_speed
			neko_transition_spd(duration, filename, vague)
		end
	end
	
# God mode function
	class Scene_Base
		alias gm_scene_update update
		def update
			gm_scene_update
			case $game_player.opening("godmode")
				when 1
					$game_party.heal_everything
				when 2
					$game_party.heal_hp_mp
				when 3
					$game_party.heal_hp_tp
				when 4
					$game_party.heal_mp_tp
				when 5
					$game_party.heal_hp_only
				when 6
					$game_party.heal_mp_only
				when 7
					$game_party.heal_tp_only
				else
			end
		end
	end
	
	class Game_Party < Game_Unit
		def heal_everything
			all_members.each do |actor|
				actor.hp = actor.mhp    if actor.hp < actor.mhp
				actor.mp = actor.mmp    if actor.mp < actor.mmp
				actor.tp = actor.max_tp if actor.tp < actor.max_tp
			end
		end
		
		def heal_hp_mp
			all_members.each do |actor|
				actor.hp = actor.mhp    if actor.hp < actor.mhp
				actor.mp = actor.mmp    if actor.mp < actor.mmp
			end
		end
		
		def heal_hp_tp
			all_members.each do |actor|
				actor.hp = actor.mhp    if actor.hp < actor.mhp
				actor.tp = actor.max_tp if actor.tp < actor.max_tp
			end
		end
		
		def heal_mp_tp
			all_members.each do |actor|
				actor.mp = actor.mmp    if actor.mp < actor.mmp
				actor.tp = actor.max_tp if actor.tp < actor.max_tp
			end
		end
		
		def heal_hp_only
			all_members.each do |actor|
				actor.hp = actor.mhp    if actor.hp < actor.mhp
			end
		end
		
		def heal_mp_only
			all_members.each do |actor|
				actor.mp = actor.mmp    if actor.mp < actor.mmp
			end
		end
		
		def heal_tp_only
			all_members.each do |actor|
				actor.tp = actor.max_tp if actor.tp < actor.max_tp
			end
		end
	end