# Teleport placeholder + main function
	class Scene_Cheat < Scene_MenuBase
		def neko_tel()
			if @neko_teleport.nil? || @neko_teleport.disposed?
				@neko_teleport = Window_CheatTel.new
				@neko_teleport.set_handler(:save_pos, method(:save_pos))
				@neko_teleport.set_handler(:tele_pos, method(:tel     ))
				@neko_teleport.set_handler(:cancel,   method(:hide_tel))
			end
			show_sub_window(@neko_teleport)
		end
	
	def hide_tel
		hide_sub_window(@neko_teleport)
	end
	
	def save_pos
		pos_file = @neko_teleport.current_ext
		File.open(pos_file, "w") { |f| f.write $game_map.map_id.to_s + ", " + $game_player.x.to_s + ", " + $game_player.y.to_s}
		return_scene
	end

		def tel
			pos_map = @neko_teleport.current_ext[0]
			pos_x   = @neko_teleport.current_ext[1]
			pos_y   = @neko_teleport.current_ext[2]
			$game_player.reserve_transfer(pos_map.to_i, pos_x.to_i, pos_y.to_i, 0)
			SceneManager.goto(Scene_Map)
		end
	end
	
# Effects edit main functions
	class Window_Cheat_Effects < Window_CheatCommand
		def initialize
			init_state_effects
			super
		end
		
		def window_width
			return 240
		end
		
		def window_height
			return fitting_height(10)
		end
		
		def init_state_effects
			@state_effects = {}
			$data_states.each do |state|
				next if state.nil?
				@state_effects[state.id] = state_default_status(state)
			end
		end
		
		def state_default_status(state)
			leader = $game_party.leader
			return false if leader.nil?
			return leader.state?(state.id)
		end
		
		def make_command_list
			return if $data_states.nil?
			
			$data_states.each do |state|
				next if state.nil?
				next if state.name.empty?
				status = @state_effects[state.id] ? "[ON]" : "[OFF]"
				display_name = "#{state.name} #{status}"
				add_command(display_name, :toggle_state, true, state.id)
			end
		end
		
		def draw_item(index)
			rect = item_rect_for_text(index)
			state_id = @list[index][:ext]
			state = $data_states[state_id]
			
			draw_icon(state.icon_index, rect.x, rect.y) if state.icon_index > 0
			text_x = rect.x + (state.icon_index > 0 ? 24 : 0)
			change_color(param_change_color(@state_effects[state_id]))
			draw_text(text_x, rect.y, rect.width - 60, line_height, state.name)
			
			status_text = @state_effects[state_id] ? "ON" : "OFF"
			draw_text(rect.x, rect.y, rect.width, line_height, status_text, 2)
		end
		
		def toggle_current_state
			state_id = current_ext
			@state_effects[state_id] = !@state_effects[state_id]
			
			refresh
			Sound.play_cursor
		end
		
		def state_enabled?(state_id)
			return @state_effects[state_id] == true
		end
		
		def param_change_color(enabled)
			enabled ? power_up_color : power_down_color
		end
	end
	
	class Scene_Cheat < Scene_MenuBase
		def edit_effects
			if @edit_effects.nil? || @edit_effects.disposed?
				@edit_effects = Window_Cheat_Effects.new
				@edit_effects.set_handler(:toggle_state, method(:on_state_toggle))
				@edit_effects.set_handler(:cancel,       method(:hide_effects   ))
			end
			show_sub_window(@edit_effects)
		end
		
		def hide_effects
			hide_sub_window(@edit_effects)
		end
		
		def on_state_toggle
			@edit_effects.toggle_current_state
			@edit_effects.activate
		end
	end

