# Stats displayer function
	class Window_StatsDisplay < Window_Base
		def initialize(x, y)
			w = window_width
			h = window_height
			super(x, y, w, h)
			@actor_index = 0
			refresh
		end
		
		def window_width
			return 128
		end
		
		def window_height
			return 384
		end
		
		def update
			super
			update_party_cycling if visible && $game_party.members.size > 1
		end
		
		def update_party_cycling
			if Input.trigger?(:RIGHT)
				Sound.play_cursor
				@actor_index = (@actor_index + 1) % $game_party.members.size
				refresh
			elsif Input.trigger?(:LEFT)
				Sound.play_cursor
				@actor_index = (@actor_index - 1) % $game_party.members.size
				refresh
			end
		end
		
		def actor_index=(index)
			return if @actor_index == index
			@actor_index = index % $game_party.members.size
			refresh
		end
		
		def draw_actor_level(actor, x, y)
			change_color(system_color)
			draw_text(x, y, 32, line_height, Vocab::level_a)
			change_color(normal_color)
			draw_text(x + 32, y, 24, line_height, actor.level, 2)
		end
		
		def refresh
			contents.clear
			actor = $game_party.members[@actor_index]
			return unless actor
			
			old_font_size = contents.font.size
			contents.font.size = 20
			
			if $game_party.members.size > 1
				y_ind = line_height * 13.5
				draw_text(0, y_ind, contents_width, line_height, "#{@actor_index + 1}/#{$game_party.members.size}", 2)
			end
			
			draw_actor_name(actor, 0, 0, contents_width)
			draw_actor_level(actor, 0, line_height)
			
			draw_actor_hp(actor, 0, line_height * 3, contents_width)
			draw_actor_mp(actor, 0, line_height * 4, contents_width)
			
			label_w = 85
			val_w = contents_width - label_w
			
			6.times do |i|
				param_id = i + 2
				y = line_height * (5 + i)
				change_color(system_color)
				draw_text(0, y, label_w, line_height, Vocab.param(param_id))
				change_color(normal_color)
				draw_text(label_w, y, val_w, line_height, actor.param(param_id), 2)
			end
			
			y_hit = line_height * 11
			draw_text(0, y_hit, label_w, line_height, "HIT")
			draw_text(label_w, y_hit, val_w, line_height, "#{(actor.hit * 100).to_i}%", 2)
			
			y_eva = line_height * 12
			draw_text(0, y_eva, label_w, line_height, "EVA")
			draw_text(label_w, y_eva, val_w, line_height, "#{(actor.eva * 100).to_i}%", 2)
			
			contents.font.size = old_font_size
		end
	end

