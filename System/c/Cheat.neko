			if @neko_gold.nil? || @neko_gold.disposed?
				@neko_gold = Window_CheatGold.new
				@neko_gold.set_handler(:edit_gold, method(:edit_gold))
				@neko_gold.set_handler(:cancel,    method(:hide_gold))
			end
			@now_menu = "gold"
			show_parameter_window
		end
		
		def hide_gold
			hide_parameter_window
		end
		
		def edit_gold
			gold_value = @neko_gold.current_ext
			if @edit_gold
			else
				@edit_gold = Edit_Interpreter.new()
			end
			@edit_gold.gold_change(gold_value)
			@edit_gold.text(NEKO::Added + gold_value.to_s + Vocab::currency_unit)
			return_scene
		end
	end

# Create parameters edit function for above menu
	class Edit_Interpreter < Game_Interpreter
		def lv_change(i)
			iterate_actor_var(0, 0) do |actor|
				actor.change_level(actor.level + i, false)
			end
		end
		
		def parameters_change(i, prmt)
			iterate_actor_var(0, 0) do |actor|
				actor.add_param(prmt, i)
			end
		end
		
		def gold_change(i)
			$game_party.gain_gold(i)
		end

		def text(i)
			$game_message.add(i)
		end
	end

# Cheat menu function
	class Window_CheatCommand < Window_Command
		def self.init_command_position
			@@last_command_symbol = nil
		end
		
		def initialize
			super(0, 0)
		end
		
		def window_width
			return 140
		end
		
		def window_height
			if item_max > 12
				return fitting_height(12)
			else
				return fitting_height(visible_line_number)
			end
		end
		
		def visible_line_number
			item_max
		end
		
		def menu_name
			return @select_cheat
		end
		
		def process_ok
			@@last_command_symbol = current_symbol
			super
		end
	end

